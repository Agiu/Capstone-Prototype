{
  "$about": "Redesign colour tokens — the single source of truth for every colour the redesign renders. Edit a token's `value` to recolour everything that uses it (redesign only; with the toggle off the prototype keeps its original hard-coded colours). `replaces` lists the original hard-coded colours this token takes over, optionally limited to one utility (`text:#0c0c0e` = only text-[#0c0c0e]). `scope`: `xbox` (default) = Xbox surfaces only, Discord pieces untouched; `all` = everywhere. Run `npm run tokens` (or just save — the dev server regenerates) after changing `replaces`.",
  "groups": {
    "accent": {
      "label": "Accent",
      "description": "Xbox green. One accent replaces the four greens and the Discord blurple the prototype mixed on Xbox surfaces.",
      "tokens": {
        "accent": {
          "value": "#9bf00b",
          "usage": "Primary buttons, selected states, links, checks, modal header band, active tab line",
          "replaces": [
            "#9bf00b",
            "#5765f2",
            "#5865f2",
            "#8aa0ff",
            "#8b95ff",
            "#107c10",
            "#3dbf1e",
            "#3fbf3f",
            "#8dff5a",
            "#0e8f0e"
          ]
        },
        "accent-bright": {
          "value": "#b6ff3d",
          "usage": "Accent hover on outlined accent elements",
          "replaces": [
            "#b6ff3d"
          ]
        },
        "on-accent": {
          "value": "#0c0c0e",
          "usage": "Text and icons sitting on a filled accent",
          "replaces": [
            "text:#0c0c0e"
          ]
        },
        "accent-text-soft": {
          "value": "#9db08f",
          "usage": "Secondary copy inside accent cards (Start A Party subtitle)",
          "replaces": [
            "#9db08f"
          ]
        },
        "accent-shade-600": {
          "value": "#164700",
          "usage": "Deep accent hover fills",
          "replaces": [
            "#164700"
          ]
        },
        "accent-shade-700": {
          "value": "#123a00",
          "usage": "Deep accent fills",
          "replaces": [
            "#123a00"
          ]
        },
        "accent-shade-800": {
          "value": "#112407",
          "usage": "Accent-tinted card hover and darkest accent tint",
          "replaces": [
            "#112407",
            "#0d1a06"
          ]
        }
      }
    },
